# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "Palestra Azzurra <sito@palestraazzurra.it>"
CONTACT_FROM=
# Optional override for the inbox (defaults to palestraazzurra.fit@gmail.com)
CONTACT_TO=

# --- Staff editor at /admin ---
# Password the staff type to log in. Leave empty to turn the editor off.
ADMIN_PASSWORD=
# Optional: long random string that signs the login cookie (e.g. `openssl rand -base64 32`).
# If empty, a key is derived from ADMIN_PASSWORD. Changing either logs everyone out.
ADMIN_SECRET=
# GitHub fine-grained personal access token, limited to the site's repository
# with "Contents: Read and write" permission only. Each save commits to the repo
# and the host rebuilds the site. Without it, local development reads and writes
# the files on disk instead; in production saving is disabled.
GITHUB_TOKEN=
# Repository and branch the editor commits to (defaults shown).
GITHUB_REPO=orlifera/palestraazzurra
GITHUB_BRANCH=main
